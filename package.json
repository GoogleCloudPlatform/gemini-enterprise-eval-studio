{
  "name": "gemini-enterprise-eval-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start:no-auth": "ng serve",
    "start:auth": "concurrently \"tsx watch src/server/main.ts\" \"ng serve --configuration auth-development\"",
    "start": "npm run start:no-auth",
    "build:no-auth": "ng build",
    "build:auth": "ng build --configuration auth-production && tsc -p tsconfig.server.json",
    "build": "npm run build:no-auth",
    "test:frontend": "ng test",
    "test:server": "tsx node_modules/jasmine/bin/jasmine.js --config=jasmine.json",
    "test": "npm run test:frontend && npm run test:server"
  },
  "dependencies": {
    "@angular/animations": "^20.3.25",
    "@angular/common": "^20.3.25",
    "@angular/compiler": "^20.3.25",
    "@angular/core": "^20.3.28",
    "@angular/forms": "^20.3.25",
    "@angular/platform-browser": "^20.3.25",
    "@angular/platform-browser-dynamic": "^20.3.25",
    "@angular/router": "^20.3.25",
    "express": "^4.20.0",
    "google-auth-library": "^9.15.0",
    "googleapis": "^149.0.0",
    "papaparse": "^5.4.1",
    "rxjs": "^7.8.2",
    "safevalues": "^1.2.0",
    "tslib": "^2.8.1",
    "winston": "^2.3.1",
    "zod": "^3.23.8",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.25",
    "@angular/cli": "^20.3.25",
    "@angular/compiler-cli": "^20.3.25",
    "@types/express": "^4.17.21",
    "@types/jasmine": "^5.1.0",
    "@types/node": "^20.11.0",
    "@types/papaparse": "^5.3.15",
    "@types/trusted-types": "^2.0.7",
    "concurrently": "^8.2.2",
    "jasmine": "^5.1.0",
    "jsdom": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "~5.8.0",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "esbuild": "^0.28.1",
    "http-proxy-middleware": "^3.0.7",
    "js-yaml": "^4.2.0",
    "launch-editor": "^2.14.1",
    "piscina": "^5.2.0",
    "serialize-javascript": "7.0.5",
    "tar": "^7.5.16",
    "uuid": "11.1.1",
    "vite": "^7.3.4",
    "webpack-dev-server": "^5.2.5",
    "ws": "^8.21.0"
  }
}
